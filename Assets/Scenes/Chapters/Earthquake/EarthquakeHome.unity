  m_EditorClassIdentifier: Assembly-CSharp::AfetUyanisi.Chapters.Earthquake.PreparationQuestManager
  mode: {fileID: 106863414}
  countdown: {fileID: 106863422}
  tasks:
  - id: emergency_bag
    label: "Afet \xE7antas\u0131n\u0131 haz\u0131rla"
    detail: "Su, g\u0131da, el feneri, d\xFCd\xFCk, ilk yard\u0131m seti: \xE7antay\u0131 haz\u0131rla, kapat ve s\u0131rt\u0131na al."
    source: 0
    keys: []
  - id: secure_bookshelf
    label: "Kitapl\u0131\u011F\u0131 sabitle"
    detail: "Devrilebilecek kitapl\u0131\u011F\u0131 depremden \xD6NCE duvara sabitle."
    source: 0
    keys: []
  - id: check_windows
    label: Pencereyi kontrol et
    detail: "Odandaki pencereyi incele: sars\u0131nt\u0131da camlardan uzak dur."
    source: 2
    keys:
    - bedroom_window
  - id: safe_spot
    label: "\xC7\xF6k\u2013Kapan\u2013Tutun yerini belirle"
    detail: "Sa\u011Flam bir masa bul: \xE7al\u0131\u015Fma masas\u0131 ya da yemek masas\u0131."
    source: 1
    keys:
    - desk
    - dining_table
  - id: family_communication
    label: Annenin sorusunu cevapla
    detail: "Annen sana bir soru soracak: deprem an\u0131nda ne yapaca\u011F\u0131n\u0131 s\xF6yle."
    source: 3
    keys:
    - Q1
  - id: utilities_location
    label: "Vana ve sigorta yerini \xF6\u011Fren"
    detail: "Oca\u011F\u0131 incele: do\u011Falgaz vanas\u0131 ve sigorta kutusunun YER\u0130N\u0130 \xF6\u011Fren (tesisata dokunma)."
    source: 1
    keys:
    - stove
  logEvents: 1
