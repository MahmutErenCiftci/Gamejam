  introLine: "Afet \xE7antas\u0131nda neler olmal\u0131? Gerekli e\u015Fyalar\u0131 se\xE7meliyim."
  idleHint: "E\u015Fyay\u0131 fareyle tut, \xE7antan\u0131n i\xE7ine b\u0131rak."
  fullWarning: "\xC7anta doldu! \xD6ncelikli ihtiya\xE7lar\u0131n\u0131 kontrol et."
  unnecessaryDefault: "Bu e\u015Fya gerekli malzemeler i\xE7in yer b\u0131rakmayabilir."
